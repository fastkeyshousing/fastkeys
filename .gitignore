# Secrets. The first line is the one that matters: .dev.vars holds a live Stripe
# key, the webhook signing secret, the Resend key and the Telegram token.
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
*.pem
*.key
*.p12
secrets.json

# Local admin tooling. Reads and writes the production database, so it stays on
# your machine. It holds no secrets of its own, but there is no reason to publish
# the schema and the endpoints of the thing that can delete customer records.
# Keep a copy somewhere backed up: if this laptop dies, so does the tool.
scripts/admin.mjs
scripts/admin-ui.html
scripts/backfill-emails.mjs

# Local state and build output
node_modules/
.wrangler/
dist/
.cache/

# Anything exported from the database. These contain applicant income,
# employer and guarantor details and must never reach a repository.
*.sqlite
*.sqlite3
*.db
*.csv
*.ndjson
backup/
backups/
exports/
applications*.json

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logs, which routinely contain email addresses and reference numbers
*.log
logs/
