# www to the apex, so there is one canonical host.
https://www.fastkeyshousing.com/*  https://fastkeyshousing.com/:splat  301!

# Anything shared while the site lived under the old GitHub Pages path.
/fastkeys/*  /:splat  301

# Extensionless URLs are the canonical form. Cloudflare Pages already redirects
# /foo.html to /foo, but these are spelled out so links printed on older material
# keep working and there is only ever one URL per page.
/index.html    /         301
/nl.html       /nl       301
/apply.html    /apply    301
/success.html  /success  301
/terms.html    /terms    301
