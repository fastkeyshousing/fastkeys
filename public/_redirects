# Specific rules first: Pages matches top-down, and putting exact paths above
# splat rules avoids scanning the wildcards on every request.
/index.html    /         301
/nl.html       /nl       301
/apply.html    /apply    301
/success.html  /success  301
/terms.html    /terms    301

# Anything shared while the site lived under the old GitHub Pages path.
/fastkeys/*  /:splat  301

# Note: www to apex is NOT handled here. Pages _redirects only accepts relative
# sources, so an absolute https://www... rule is silently skipped at build time.
# Do it at the zone level instead: Cloudflare dashboard -> fastkeyshousing.com ->
# Rules -> Redirect Rules -> Create, matching hostname equals
# www.fastkeyshousing.com, dynamic redirect to
# concat("https://fastkeyshousing.com", http.request.uri.path), status 301.
